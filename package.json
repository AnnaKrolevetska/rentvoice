{
  "name": "rentvoice",
  "version": "1.0.0",
  "description": "Browser voice agent for an equipment rental desk",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "evidence": "node scripts/logic-evidence.mjs",
    "voice-eval": "node --env-file-if-exists=.env scripts/voice-eval.mjs",
    "reset-db": "node --env-file-if-exists=.env scripts/reset-db.mjs",
    "voice-eval:mock": "node scripts/mock-realtime.mjs --exit-after 60 & sleep 1; OPENAI_API_KEY=mock OPENAI_BASE_URL=http://localhost:8787 OPENAI_REALTIME_URL=ws://localhost:8787 EVAL_AUDIO_DIR=data/mock-audio EVAL_OUT_DIR=data/mock-evidence node scripts/voice-eval.mjs --only S1,S5",
    "migrate-seed": "node --env-file-if-exists=.env scripts/migrate-seed.mjs",
    "db:snapshot": "node --env-file-if-exists=.env scripts/db-snapshot.mjs",
    "start:test-db": "DB_PATH=data/test-run.db node --env-file-if-exists=.env src/server.js",
    "test-db:snapshot": "DB_PATH=data/test-run.db node scripts/db-snapshot.mjs",
    "test-db:reset": "DB_PATH=data/test-run.db node scripts/reset-db.mjs --yes"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "ws": "^8.22.1"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "private": true
}
