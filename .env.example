# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Desk "today" — keep this line. The brief seeds a Camera A booking for
# 10–12 Oct 2026; with the desk date fixed to 1 Oct 2026 those dates are still in
# the future, so every test scenario (e.g. two cameras on 11–12 Oct) works on any day.
APP_TODAY=2026-10-01

# Voice model: gpt-realtime-2.1-mini (default, cheaper) or gpt-realtime-2.1 (stronger, ~3x price)
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Turn detection: semantic_vad (waits for a finished thought) or server_vad (silence-based, faster)
VAD_TYPE=semantic_vad
VAD_EAGERNESS=medium

PORT=3000
DB_PATH=data/rentvoice.db
# Set to protect a publicly hosted demo (the browser will ask for it)
DEMO_PASSCODE=
